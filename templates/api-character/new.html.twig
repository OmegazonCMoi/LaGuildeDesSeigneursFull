{% extends 'base.html.twig' %}

{% block title %}Nouveau personnage{% endblock %}

{% block body %}
    <div class="bg-light p-5">
        <div class="row">
            <div class="col-6 offset-3">

                <div class="mb-3">
                    <div class="text-uppercase text-secondary fw-medium mb-1" style="font-size:11px;letter-spacing:.12em">Bestiaire</div>
                    <h1 class="h3 fw-bold mb-0">Nouveau personnage</h1>
                </div>

                <div class="card border rounded-4 shadow-sm p-4">
                    {{ include('character/_form.html.twig') }}
                </div>

                <a href="{{ path('app_character_index') }}" class="btn btn-link btn-sm text-secondary text-decoration-none px-0 mt-3">← Retour à la liste</a>

            </div>
        </div>
    </div>
{% endblock %}
