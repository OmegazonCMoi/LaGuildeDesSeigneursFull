{% extends 'base.html.twig' %}

{% block title %}Modifier le personnage{% endblock %}

{% block body %}
    <div class="bg-light p-5">
        <div class="row">
            <div class="col-6 offset-3">

                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="text-uppercase text-secondary fw-medium mb-1" style="font-size:11px;letter-spacing:.12em">Bestiaire</div>
                        <h1 class="h3 fw-bold mb-0">Modifier le personnage</h1>
                    </div>
                    {% if character.kind == 'Dame' %}
                        <strong><span class="badge bg-dark rounded-pill px-3 py-2">{{ character.kind }}</span></strong>
                    {% else %}
                        <span class="badge bg-light text-secondary border rounded-pill px-3 py-2">{{ character.kind }}</span>
                    {% endif %}
                </div>

                <div class="card border rounded-4 shadow-sm p-4">
                    {{ include('character/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
                </div>

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <a href="{{ path('app_character_index') }}" class="btn btn-link btn-sm text-secondary text-decoration-none px-0">← Retour à la liste</a>
                    {{ include('character/_delete_form.html.twig') }}
                </div>

            </div>
        </div>
    </div>
{% endblock %}
