{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;padding:3rem">
        <div style="width:100%;max-width:380px">

            <div class="text-center mb-4">
                <div class="text-uppercase text-secondary fw-medium mb-1" style="font-size:11px;letter-spacing:.12em">Bestiaire</div>
                <h1 class="h3 fw-bold mb-1">Connexion</h1>
                <div class="text-secondary small">Accédez à votre espace</div>
            </div>

            {% if app.user %}
                <div class="alert alert-secondary rounded-3 small py-2 px-3 mb-3">
                    Connecté en tant que {{ app.user.userIdentifier }} —
                    <a href="{{ logout_path() }}" class="alert-link">Déconnexion</a>
                </div>
            {% endif %}

            <form method="post" action="{{ path('api_login') }}" class="card border rounded-4 shadow-sm p-4">
                <div class="mb-3">
                    <label for="username" class="form-label small text-secondary fw-medium">Email</label>
                    <input type="email" name="_username" id="username" class="form-control" autocomplete="email" placeholder="vous@exemple.com" required autofocus>
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label small text-secondary fw-medium">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required>
                </div>

                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                    <label class="form-check-label small text-secondary" for="_remember_me">Se souvenir de moi</label>
                </div>

                <button class="btn btn-dark w-100 rounded-3 py-2" type="submit">Se connecter</button>
            </form>

        </div>
    </div>
{% endblock %}
