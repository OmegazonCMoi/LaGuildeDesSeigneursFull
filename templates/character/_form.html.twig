{{ form_start(form) }}
    <div class="row g-3">
        <div class="col-6">{{ form_row(form.name) }}</div>
        <div class="col-6">{{ form_row(form.surname) }}</div>
        <div class="col-6">{{ form_row(form.kind) }}</div>
        <div class="col-6">{{ form_row(form.caste) }}</div>
        <div class="col-6">{{ form_row(form.slug) }}</div>
        <div class="col-4">{{ form_row(form.knowledge) }}</div>
        <div class="col-4">{{ form_row(form.intelligence) }}</div>
        <div class="col-4">{{ form_row(form.strength) }}</div>
        <div class="col-12">{{ form_row(form.image) }}</div>
    </div>
    <div class="d-flex justify-content-end mt-4">
        <button class="btn btn-dark rounded-3 px-4">Enregistrer</button>
    </div>
{{ form_end(form) }}
