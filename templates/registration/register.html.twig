{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="bg-light d-flex align-items-center justify-content-center" style="min-height:100vh;padding:3rem">
    <div style="width:100%;max-width:380px">

        <div class="text-center mb-4">
            <div class="text-uppercase text-secondary fw-medium mb-1" style="font-size:11px;letter-spacing:.12em">Bestiaire</div>
            <h1 class="h3 fw-bold mb-1">Inscription</h1>
            <div class="text-secondary small">Créez votre compte</div>
        </div>

        {% for flash_error in app.flashes('verify_email_error') %}
            <div class="alert alert-danger rounded-3 small py-2 px-3 mb-3" role="alert">{{ flash_error }}</div>
        {% endfor %}

        {{ form_errors(registrationForm) }}

        {{ form_start(registrationForm, {'attr': {'class': 'card border rounded-4 shadow-sm p-4'}}) }}
        {{ form_row(registrationForm.email, {
            label: 'Email',
            attr: {placeholder: 'vous@exemple.com'}
        }) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe'
        }) }}
        {{ form_row(registrationForm.agreeTerms, {
            label: "J'accepte les conditions d'utilisation"
        }) }}

        <button type="submit" class="btn btn-dark w-100 rounded-3 py-2">Créer mon compte</button>
        {{ form_end(registrationForm) }}

    </div>
</div>
{% endblock %}
